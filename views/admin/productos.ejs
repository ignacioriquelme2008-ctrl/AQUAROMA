<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Productos | Administración | AQUAROMA', estilos: ['admin'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <!-- HU-036 y HU-037: lista de productos del panel. Los datos llegan de adminProductosController.listar. -->
  <main class="admin admin-ancho">
    <a href="/admin" class="admin-volver">← Volver al panel</a>
    <div class="admin-cabecera">
      <div>
        <p class="eyebrow">Administración</p>
        <h1>Productos</h1>
      </div>
      <a href="/admin/productos/nuevo" class="btn btn-primary">+ Nuevo producto</a>
    </div>

    <%# Aviso después de crear, editar, activar, desactivar o eliminar (lo arma el controlador). %>
    <% if (aviso && aviso.tipo === 'exito') { %>
      <p class="admin-exito" role="status">
        <% if (aviso.producto) { %>
          <%= aviso.texto %> <strong><%= aviso.producto.nombre %></strong> (SKU <%= aviso.producto.sku %>).
          <% if (aviso.producto.activo) { %><a href="/catalogo/<%= aviso.producto.id %>">Ver en la tienda →</a>
          <% } else { %>Está inactivo, así que no se muestra en la tienda.<% } %>
        <% } else { %>
          <%= aviso.texto %>
        <% } %>
      </p>
    <% } else if (aviso && aviso.tipo === 'error') { %>
      <%# Criterio 3 de HU-037: un producto con pedidos no se borra; se sugiere desactivarlo. %>
      <div class="admin-errores" role="alert">
        <%= aviso.texto %> <strong><%= aviso.producto.nombre %></strong> porque tiene pedidos asociados: se perdería el historial de ventas.
        <% if (aviso.producto.activo) { %>
          Puedes <strong>desactivarlo</strong> para que deje de aparecer en la tienda:
          <form method="post" action="/admin/productos/<%= aviso.producto.id %>/activo" class="admin-form-linea">
            <input type="hidden" name="activo" value="0">
            <button type="submit" class="admin-boton-chico">Desactivar ahora</button>
          </form>
        <% } else { %>
          Ya está desactivado, así que no aparece en la tienda.
        <% } %>
      </div>
    <% } %>

    <table class="admin-tabla">
      <thead>
        <tr><th>SKU</th><th>Nombre</th><th>Aroma</th><th>Tipo de agua</th><th class="num">Precio</th><th class="num">Stock</th><th>Estado</th><th>Últ. modificación</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% productos.forEach(p => { %>
          <tr<%- creado && creado.id === p.id ? ' class="admin-fila-nueva"' : '' %>>
            <td class="sku"><%= p.sku %></td>
            <td><% if (p.activo) { %><a href="/catalogo/<%= p.id %>"><%= p.nombre %></a><% } else { %><%= p.nombre %><% } %></td>
            <td><%= p.aroma || '—' %></td>
            <td><%= p.tipo %></td>
            <td class="num"><%= clp(p.precio) %></td>
            <td class="num"><%= p.stock %></td>
            <td><span class="admin-chip <%= p.activo ? 'activo' : 'inactivo' %>"><%= p.activo ? 'Activo' : 'Inactivo' %></span></td>
            <td class="admin-fecha"><%= p.actualizado_en ? fechaHora(p.actualizado_en) : '—' %></td>
            <td class="admin-acciones-fila">
              <a href="/admin/productos/<%= p.id %>/editar">Editar</a>
              <%# HU-037: activar o desactivar sin borrar nada. %>
              <form method="post" action="/admin/productos/<%= p.id %>/activo" class="admin-form-linea">
                <input type="hidden" name="activo" value="<%= p.activo ? '0' : '1' %>">
                <button type="submit" class="admin-boton-chico"><%= p.activo ? 'Desactivar' : 'Activar' %></button>
              </form>
              <%# Eliminar solo funciona si el producto nunca se vendió (el servidor lo revisa). %>
              <form method="post" action="/admin/productos/<%= p.id %>/eliminar" class="admin-form-linea"
                    onsubmit="return confirm('¿Eliminar <%= p.sku %> para siempre? Si tiene pedidos no se podrá.')">
                <button type="submit" class="admin-boton-chico admin-boton-peligro">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="admin-nota">"Desactivar" saca el producto de la tienda y conserva sus pedidos. "Eliminar" solo se permite si el producto nunca se vendió.</p>
  </main>
</body>
</html>
