<!DOCTYPE html>
<html lang="es">
<%
  // Este formulario sirve para CREAR (HU-036) y para EDITAR (HU-037).
  // producto = el producto que se edita; null o ausente = producto nuevo.
  const p = locals.producto || null;
%>
<head>
  <%- include('../partials/head', { titulo: (p ? 'Editar producto' : 'Nuevo producto') + ' | Administración | AQUAROMA', estilos: ['admin'] }) %>
  <script src="/js/admin-producto.js" defer></script>
</head>
<body>
  <%- include('../partials/navbar') %>

  <%
    // datos = lo que escribió el administrador (si hubo errores, el formulario vuelve con todo lleno).
    // errores = { campo: 'mensaje' }: cada campo con problema se marca en rojo con su mensaje debajo.
    const d = datos || {};
    const marca = (campo) => errores[campo] ? 'class="campo-error" aria-invalid="true"' : '';
    const aviso = (campo) => errores[campo] ? '<p class="admin-aviso">' + errores[campo].replace(/</g, '&lt;') + '</p>' : '';
    const sel = (valor, id) => Number(valor) === id ? 'selected' : '';
    const hayErrores = Object.keys(errores).length > 0;
  %>
  <!-- HU-036: crear un producto (POST /admin/productos, adminProductosController.crear).
       HU-037: editarlo (POST /admin/productos/:id, adminProductosController.guardarEdicion). -->
  <main class="admin admin-angosto">
    <%- include('../partials/admin-menu', { activo: 'productos' }) %>
    <a href="/admin/productos" class="admin-volver">← Volver a productos</a>
    <p class="eyebrow">Administración</p>
    <h1><%= p ? 'Editar producto' : 'Nuevo producto' %></h1>
    <% if (p) { %>
      <%# Criterio 1 de HU-037: se guarda y se muestra la fecha de última modificación. %>
      <p class="admin-sub">
        SKU <strong><%= p.sku %></strong> · Creado el <%= fechaHora(p.creadoEn) %> ·
        Última modificación: <%= p.actualizadoEn ? fechaHora(p.actualizadoEn) : 'sin cambios desde que se creó' %>
      </p>
    <% } %>

    <% if (hayErrores) { %>
      <p class="admin-errores" role="alert">Revisa los campos marcados en rojo.</p>
    <% } %>

    <form class="admin-form" method="post" action="<%= p ? '/admin/productos/' + p.id : '/admin/productos' %>" enctype="multipart/form-data" novalidate>
      <fieldset>
        <legend>Datos del producto</legend>
        <div class="admin-fila">
          <div class="admin-campo">
            <label for="sku">Código SKU</label>
            <% if (p) { %>
              <%# El SKU no se edita: identifica al producto en los pedidos ya hechos. %>
              <input type="text" id="sku" value="<%= p.sku %>" readonly aria-describedby="sku-ayuda">
              <p class="admin-ayuda" id="sku-ayuda">El SKU no se puede cambiar.</p>
            <% } else { %>
              <input <%- marca('sku') %> type="text" id="sku" name="sku" value="<%= d.sku || '' %>" maxlength="30" placeholder="AQ-MAN-500" required autofocus>
              <%- aviso('sku') %>
            <% } %>
          </div>
          <div class="admin-campo">
            <label for="nombre">Nombre</label>
            <input <%- marca('nombre') %> type="text" id="nombre" name="nombre" value="<%= d.nombre || '' %>" maxlength="120" placeholder="AQUAROMA Mango" required>
            <%- aviso('nombre') %>
          </div>
        </div>

        <div class="admin-fila admin-fila-3">
          <div class="admin-campo">
            <label for="idTipoAgua">Tipo de agua</label>
            <select <%- marca('idTipoAgua') %> id="idTipoAgua" name="idTipoAgua" required>
              <option value="">Elegir…</option>
              <% opciones.tipos.forEach(o => { %><option value="<%= o.id %>" <%= sel(d.idTipoAgua, o.id) %>><%= o.nombre %></option><% }) %>
            </select>
            <%- aviso('idTipoAgua') %>
          </div>
          <div class="admin-campo">
            <label for="idPresentacion">Presentación</label>
            <select <%- marca('idPresentacion') %> id="idPresentacion" name="idPresentacion" required>
              <option value="">Elegir…</option>
              <% opciones.presentaciones.forEach(o => { %>
                <option value="<%= o.id %>" <%= sel(d.idPresentacion, o.id) %>><%= o.volumen_ml %> ml · <%= o.tipo_envase || o.nombre %></option>
              <% }) %>
            </select>
            <%- aviso('idPresentacion') %>
          </div>
          <div class="admin-campo">
            <label for="idCategoria">Sabor y aroma</label>
            <select <%- marca('idCategoria') %> id="idCategoria" name="idCategoria" aria-controls="nuevo-sabor-campo" required>
              <option value="nueva" <%= d.categoriaNueva || !d.idCategoria ? 'selected' : '' %>>+ Crear nuevo sabor y aroma</option>
              <% opciones.categorias.forEach(o => { %><option value="<%= o.id %>" <%= sel(d.idCategoria, o.id) %>><%= o.nombre %></option><% }) %>
            </select>
            <%- aviso('idCategoria') %>
            <div id="nuevo-sabor-campo" class="admin-nuevo-sabor">
              <label for="nombreCategoriaNueva">Nombre del nuevo sabor y aroma</label>
              <input <%- marca('nombreCategoriaNueva') %> type="text" id="nombreCategoriaNueva" name="nombreCategoriaNueva" maxlength="100" value="<%= d.nombreCategoriaNueva || '' %>" placeholder="Ej.: Maracuyá">
              <%- aviso('nombreCategoriaNueva') %>
            </div>
          </div>
        </div>

        <div class="admin-fila">
          <div class="admin-campo">
            <label for="precio">Precio (CLP, IVA incluido)</label>
            <input <%- marca('precio') %> type="number" id="precio" name="precio" value="<%= d.precioTexto || '' %>" min="1" step="1" placeholder="1490" required>
            <%- aviso('precio') %>
          </div>
          <div class="admin-campo">
            <label for="imagenArchivo">Foto del producto</label>
            <input <%- marca('imagen') %> type="file" id="imagenArchivo" name="imagenArchivo" accept="image/jpeg,image/png,image/webp" aria-describedby="imagen-ayuda">
            <p class="admin-ayuda" id="imagen-ayuda">JPG, PNG o WebP, hasta 5 MB. Se asigna al producto al guardar.</p>
            <img id="imagen-producto-preview" class="admin-imagen-preview" <%- d.imagen ? 'src="' + imagenProducto(d.imagen).replace(/"/g, '&quot;') + '"' : '' %> alt="Vista previa de la foto del producto" <%= d.imagen ? '' : 'hidden' %>>
            <label for="imagen">O usar una imagen existente</label>
            <select id="imagen" name="imagen">
              <option value="">Elegir…</option>
              <% imagenes.forEach(img => { %><option value="<%= img %>" data-src="<%= imagenProducto(img) %>" <%= d.imagen === img ? 'selected' : '' %>><%= img %></option><% }) %>
            </select>
            <%- aviso('imagen') %>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Textos de la tienda</legend>
        <div class="admin-campo">
          <label for="etiqueta">Descripción corta</label>
          <input <%- marca('etiqueta') %> type="text" id="etiqueta" name="etiqueta" value="<%= d.etiqueta || '' %>" maxlength="40" placeholder="Tropical y dulce" required>
          <%- aviso('etiqueta') %>
          <p class="admin-ayuda">Se muestra en la tarjeta del catálogo y arriba del nombre en la ficha.</p>
        </div>
        <div class="admin-campo">
          <label for="descripcionLarga">Descripción completa <span class="admin-opcional">(opcional)</span></label>
          <textarea <%- marca('descripcionLarga') %> id="descripcionLarga" name="descripcionLarga" rows="4" maxlength="1000"><%= d.descripcionLarga || '' %></textarea>
          <%- aviso('descripcionLarga') %>
        </div>
      </fieldset>

      <% if (p) { %>
        <%# Al editar no se cambia el stock aquí: tiene su propia pantalla con motivo y registro (HU-038). %>
        <p class="admin-ayuda">El stock de este producto se ajusta en <a href="/admin/stock">Stock por sucursal</a>.</p>
      <% } else { %>
      <fieldset>
        <legend>Stock inicial <span class="admin-opcional">(opcional)</span></legend>
        <div class="admin-fila">
          <div class="admin-campo">
            <label for="stockInicial">Unidades</label>
            <input <%- marca('stockInicial') %> type="number" id="stockInicial" name="stockInicial" value="<%= d.stockTexto || '' %>" min="0" step="1" placeholder="0">
            <%- aviso('stockInicial') %>
          </div>
          <div class="admin-campo">
            <label for="idSucursal">Sucursal</label>
            <select <%- marca('idSucursal') %> id="idSucursal" name="idSucursal">
              <% opciones.sucursales.forEach(o => { %><option value="<%= o.id %>" <%= sel(d.idSucursal, o.id) %>><%= o.nombre %></option><% }) %>
            </select>
            <%- aviso('idSucursal') %>
          </div>
        </div>
        <p class="admin-ayuda">Sin stock, el producto se ve en la tienda como "Agotado". Después se ajusta en <a href="/admin/stock">Stock por sucursal</a>.</p>
      </fieldset>
      <% } %>

      <fieldset>
        <legend>Opciones</legend>
        <%# Una casilla sin marcar no se envía: el controlador lo entiende como "no". %>
        <label class="admin-check"><input type="checkbox" name="esPersonalizable" value="1" <%= d.esPersonalizable ? 'checked' : '' %>> Personalizable (el cliente puede ajustar el sabor y aroma)</label>
        <label class="admin-check"><input type="checkbox" name="activo" value="1" <%= d.activo ? 'checked' : '' %>> Activo (se muestra en la tienda apenas se guarda)</label>
      </fieldset>

      <div class="admin-acciones">
        <a href="/admin/productos" class="admin-cancelar">Cancelar</a>
        <button type="submit" class="btn btn-primary"><%= p ? 'Guardar cambios' : 'Guardar producto' %></button>
      </div>
    </form>
  </main>
</body>
</html>
