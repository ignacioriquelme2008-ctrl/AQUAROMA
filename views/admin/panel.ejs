<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Panel de administración | AQUAROMA', estilos: ['admin'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <!-- Portada del panel (HU-006) con el resumen de la tienda (HU-035).
       Solo llega aquí un Administrador: lo controla el middleware soloAdmin (criterio 3 de HU-035). -->
  <main class="admin">
    <p class="eyebrow">Administración</p>
    <h1>Panel de administración</h1>
    <p class="admin-sub">Hola, <%= usuario.nombre %>. Este es el resumen de la tienda.</p>

    <%# Criterio 1 de HU-035: cifras resumidas. Criterio 2 de HU-039: indicador de stock crítico. %>
    <div class="admin-kpis">
      <div class="admin-kpi">
        <span class="admin-kpi-titulo">Ventas acumuladas</span>
        <strong><%= clp(ventas.monto) %></strong>
        <span class="admin-kpi-nota"><%= ventas.pedidos %> <%= ventas.pedidos === 1 ? 'pedido pagado o en curso' : 'pedidos pagados o en curso' %></span>
      </div>
      <div class="admin-kpi">
        <span class="admin-kpi-titulo">Por despachar</span>
        <strong><%= porEstado.confirmado + porEstado.pagado + porEstado.preparando %></strong>
        <span class="admin-kpi-nota">confirmados, pagados o en preparación</span>
      </div>
      <a class="admin-kpi <%= stockBajo > 0 ? 'admin-kpi-alerta' : '' %>" href="<%= puedeVerStock ? '/admin/stock?bajo=1' : '#' %>">
        <span class="admin-kpi-titulo">Stock bajo</span>
        <strong><%= stockBajo > 0 ? '⚠ ' : '' %><%= stockBajo %></strong>
        <span class="admin-kpi-nota"><%= stockBajo === 1 ? 'producto en alerta' : 'productos en alerta' %></span>
      </a>
      <div class="admin-kpi <%= mensajes.total > 0 ? 'admin-kpi-aviso' : '' %>">
        <span class="admin-kpi-titulo">Mensajes sin leer</span>
        <strong><%= mensajes.total %></strong>
        <span class="admin-kpi-nota">del formulario de contacto</span>
      </div>
    </div>

    <div class="admin-dos-columnas">
      <%# Criterio 1 de HU-035: gráfico con la distribución de pedidos por estado. %>
      <section class="admin-caja">
        <h2>Pedidos por estado</h2>
        <% const maximo = Math.max(1, ...Object.values(porEstado)); %>
        <ul class="admin-barras">
          <% Object.keys(nombres).forEach(e => { %>
            <li>
              <span class="admin-barra-nombre"><%= nombres[e] %></span>
              <span class="admin-barra"><span class="admin-barra-relleno <%= e %>" style="width: <%= Math.round(porEstado[e] / maximo * 100) %>%"></span></span>
              <span class="admin-barra-n"><%= porEstado[e] %></span>
            </li>
          <% }) %>
        </ul>
      </section>

      <%# Criterio 2 de HU-035: mensajes recibidos sin leer. %>
      <section class="admin-caja">
        <h2>Mensajes sin leer</h2>
        <% if (mensajes.ultimos.length === 0) { %>
          <p class="admin-minimo">No hay mensajes nuevos.</p>
        <% } else { %>
          <ul class="admin-mensajes">
            <% mensajes.ultimos.forEach(m => { %>
              <li><strong><%= m.asunto %></strong><span class="admin-minimo"><%= m.nombre %> · <%= m.correo %> · <%= fechaHora(m.creado_en) %></span></li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>

    <%# Criterio 2 de HU-035: accesos directos a los últimos 10 pedidos. %>
    <section class="admin-caja">
      <div class="admin-cabecera admin-cabecera-chica">
        <h2>Últimos pedidos</h2>
        <% if (puedeVerPedidos) { %><a href="/admin/pedidos">Ver todos →</a><% } %>
      </div>
      <% if (ultimos.length === 0) { %>
        <p class="admin-minimo">Todavía no hay pedidos.</p>
      <% } else { %>
        <table class="admin-tabla admin-tabla-simple">
          <thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th class="num">Total</th><th>Estado</th></tr></thead>
          <tbody>
            <% ultimos.forEach(p => { %>
              <tr>
                <td class="sku"><% if (puedeVerPedidos) { %><a href="/admin/pedidos/<%= p.id %>">#<%= p.id %></a><% } else { %>#<%= p.id %><% } %></td>
                <td class="admin-fecha"><%= fechaHora(p.fecha) %></td>
                <td><%= p.cliente %></td>
                <td class="num"><%= clp(p.total + p.costo_envio) %></td>
                <td><span class="admin-estado-pedido <%= p.estado %>"><%= nombres[p.estado] %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <h2 class="admin-subtitulo">Secciones</h2>
    <div class="admin-grid">
      <% secciones.forEach(s => { %>
        <%# Una sección con "url" (y con permiso) ya está hecha: la tarjeta completa es un enlace. %>
        <% if (s.url && s.permitido) { %>
          <a class="admin-card admin-card-lista" href="<%= s.url %>">
            <span class="admin-estado admin-estado-lista">Disponible</span>
            <h2><%= s.titulo %></h2>
            <p><%= s.descripcion %></p>
          </a>
        <% } else { %>
          <article class="admin-card<%= s.permitido ? '' : ' admin-card-bloqueada' %>">
            <span class="admin-estado"><%= s.permitido ? 'Próximamente' : 'Sin permiso' %></span>
            <h2><%= s.titulo %></h2>
            <p><%= s.descripcion %></p>
          </article>
        <% } %>
      <% }) %>
    </div>
  </main>
</body>
</html>
