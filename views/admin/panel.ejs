<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Por atender | Administración | AQUAROMA', estilos: ['admin'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="admin admin-inicio">
    <h1>Panel de administración</h1>
    <%- include('../partials/admin-menu', { activo: 'resumen' }) %>

    <section aria-labelledby="pendientes-titulo">
      <h2 id="pendientes-titulo">Por atender</h2>
      <p class="admin-sub">Lo que necesita tu atención hoy.</p>

      <div class="admin-bandeja">
        <% if (!grupos.length) { %>
          <p class="admin-bandeja-vacia">Todo al día. No hay avisos pendientes.</p>
        <% } %>
        <% grupos.forEach(grupo => { %>
          <div class="admin-bandeja-grupo">
            <h3><%= grupo.titulo %></h3>
            <ul>
              <% grupo.filas.forEach(aviso => { %>
                <li class="admin-aviso">
                  <span class="admin-aviso-estado <%= aviso.tono %>"><%= aviso.estado %></span>
                  <div>
                    <strong><%= aviso.titulo %></strong>
                    <small><%= aviso.detalle %><% if (aviso.fecha) { %> · <time><%= fechaHora(aviso.fecha) %></time><% } %></small>
                  </div>
                  <a class="admin-boton-chico" href="<%= aviso.url %>"><%= aviso.accion %></a>
                </li>
              <% }) %>
            </ul>
            <% if (grupo.mas) { %><a class="admin-bandeja-mas" href="<%= grupo.url %>">Ver todos · <%= grupo.titulo %></a><% } %>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="admin-caja admin-actividad" aria-labelledby="actividad-titulo">
      <h2 id="actividad-titulo">Actividad reciente</h2>
      <% if (!recientes.length) { %>
        <p class="admin-minimo">Todavía no hay actividad para mostrar.</p>
      <% } else { %>
        <ul>
          <% recientes.forEach(item => { %>
            <li><a href="<%= item.url %>"><%= item.titulo %></a> <time><%= fechaHora(item.fecha) %></time></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
</body>
</html>
