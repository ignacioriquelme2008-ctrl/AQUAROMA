<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Iniciar sesión | AQUAROMA', estilos: ['usuarios'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="auth">
    <form class="auth-card" method="post" action="/login" novalidate>
      <!-- HU-006: página privada a la que se vuelve después de iniciar sesión (si venía de una). -->
      <input type="hidden" name="volver" value="<%= locals.volver || '' %>">
      <h1>Iniciar sesión</h1>
      <p class="auth-sub">Ingresa con tu correo y contraseña.</p>

      <!-- Errores que devuelve el servidor (por ejemplo, correo o contraseña incorrectos).
           Acepta una lista, un objeto {campo: mensaje} o un solo texto. -->
      <%
        const e1 = locals.errores || [];
        const lista = [].concat(Array.isArray(e1) || typeof e1 === 'string' ? e1 : Object.values(e1), locals.error || []).filter(Boolean);
      %>
      <%# Mensaje verde después de registrarse (?registrado=1) y aviso cuando viene de una página privada (HU-004). %>
      <% if (locals.exito) { %><p class="auth-exito" role="status"><%= exito %></p><% } %>
      <% if (locals.passwordRestablecida) { %><p class="auth-exito" role="status">Tu contraseña fue actualizada. Ya puedes iniciar sesión.</p><% } %>
      <% if (locals.aviso && !lista.length) { %><p class="auth-info" role="status"><%= aviso %></p><% } %>
      <% if (lista.length) { %>
        <ul class="auth-errores" role="alert">
          <% lista.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      <% } %>

      <div class="auth-campo">
        <label for="correo">Correo electrónico</label>
        <input type="email" id="correo" name="correo" value="<%= correo %>" maxlength="120" autocomplete="email" required autofocus>
      </div>

      <div class="auth-campo">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn-primary auth-boton">Ingresar</button>
      <p class="auth-pie"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
      <p class="auth-pie">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
    </form>
  </main>
</body>
</html>
