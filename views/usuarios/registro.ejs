<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Crear cuenta | AQUAROMA', estilos: ['usuarios'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="auth">
    <%
      const e1 = locals.errores || [];
      const lista = [].concat(Array.isArray(e1) || typeof e1 === 'string' ? e1 : Object.values(e1), locals.error || []).filter(Boolean);
      const d = locals.datos || {};
      // HU-002: errores por campo ({ nombre: 'mensaje', ... }) para resaltar cada campo con problema.
      const err = (e1 && typeof e1 === 'object' && !Array.isArray(e1)) ? e1 : {};
      const marca = (campo) => err[campo] ? 'class="campo-error" aria-invalid="true"' : '';
      // Largo permitido de la contraseña: debe coincidir con la regla del controlador.
      const MIN = locals.PASS_MIN || 8, MAX = locals.PASS_MAX || 20;
    %>
    <form class="auth-card" method="post" action="/registro" novalidate>
      <h1>Crear cuenta</h1>
      <p class="auth-sub">Regístrate para comprar en Aquaroma.</p>

      <!-- Errores que devuelve el servidor. Acepta una lista, un objeto {campo: mensaje} o un solo texto. -->
      <% if (lista.length) { %>
        <ul class="auth-errores" role="alert">
          <% lista.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      <% } %>

      <div class="auth-fila">
        <div class="auth-campo">
          <label for="nombre">Nombre</label>
          <input <%- marca('nombre') %> type="text" id="nombre" name="nombre" value="<%= d.nombre || '' %>" minlength="2" maxlength="100" autocomplete="given-name" required autofocus>
          <% if (err.nombre) { %><p class="auth-aviso"><%= err.nombre %></p><% } %>
        </div>
        <div class="auth-campo">
          <label for="apellido">Apellido</label>
          <input <%- marca('apellido') %> type="text" id="apellido" name="apellido" value="<%= d.apellido || '' %>" minlength="2" maxlength="100" autocomplete="family-name" required>
          <% if (err.apellido) { %><p class="auth-aviso"><%= err.apellido %></p><% } %>
        </div>
      </div>

      <div class="auth-campo">
        <label for="correo">Correo electrónico</label>
        <input <%- marca('correo') %> type="email" id="correo" name="correo" value="<%= d.correo || '' %>" maxlength="120" autocomplete="email" required>
        <% if (err.correo) { %><p class="auth-aviso"><%= err.correo %></p><% } %>
      </div>

      <div class="auth-campo">
        <label for="telefono">Teléfono</label>
        <input <%- marca('telefono') %> type="tel" id="telefono" name="telefono" value="<%= d.telefono || '' %>" maxlength="20" placeholder="+56912345678" autocomplete="tel" required>
        <% if (err.telefono) { %><p class="auth-aviso"><%= err.telefono %></p><% } %>
      </div>

      <div class="auth-campo">
        <label for="password">Contraseña</label>
        <input <%- marca('password') %> type="password" id="password" name="password" maxlength="<%= MAX %>" autocomplete="new-password" aria-describedby="reglas" required>
        <% if (err.password) { %><p class="auth-aviso"><%= err.password %></p><% } %>
        <!-- Requisitos de la contraseña. El servidor es el que valida (controllers/usuariosController.js). -->
        <ul class="auth-reglas" id="reglas">
          <li>Entre <%= MIN %> y <%= MAX %> caracteres</li>
          <li>Una letra mayúscula</li>
          <li>Una letra minúscula</li>
          <li>Un número</li>
          <li>Un carácter especial (! @ # $ % & *)</li>
        </ul>
      </div>

      <div class="auth-campo">
        <label for="confirmar">Repite la contraseña</label>
        <input <%- marca('confirmar') %> type="password" id="confirmar" name="confirmar" maxlength="<%= MAX %>" autocomplete="new-password" required>
        <% if (err.confirmar) { %><p class="auth-aviso"><%= err.confirmar %></p><% } %>
      </div>

      <button type="submit" class="btn btn-primary auth-boton">Crear cuenta</button>
      <p class="auth-pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </form>
  </main>
</body>
</html>
