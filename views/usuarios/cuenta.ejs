<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Mi cuenta | AQUAROMA', estilos: ['usuarios'] }) %>
  <script src="/js/cuenta.js" defer></script>
</head>
<body class="account-page">
  <%- include('../partials/navbar') %>
  <main class="account-main">
    <section class="account-shell" aria-labelledby="account-title" data-modo="<%= modo %>">
      <aside class="account-welcome">
        <span class="account-brand">AQUAROMA</span>
        <h2>Tu bienestar<br>empieza aquí.</h2>
        <p>Agua, frescura y aromas para tu día a día.</p>
      </aside>
      <div class="account-content">
        <h1 id="account-title">Mi cuenta</h1>
        <p class="account-subtitle">Qué bueno tenerte aquí</p>
        <nav class="account-tabs" aria-label="Acceso a tu cuenta">
          <a id="tab-login" href="/login" aria-controls="panel-login" <%- modo === 'login' ? 'aria-current="page"' : '' %>>Iniciar sesión</a>
          <a id="tab-registro" href="/registro" aria-controls="panel-registro" <%- modo === 'registro' ? 'aria-current="page"' : '' %>>Crear cuenta</a>
        </nav>
        <div <%= modo !== 'login' ? 'hidden' : '' %> data-panel="login">
<% { %>
    <form class="account-form" id="panel-login" aria-labelledby="tab-login" method="post" action="/login" novalidate>
      <!-- HU-006: página privada a la que se vuelve después de iniciar sesión (si venía de una). -->
      <input type="hidden" name="volver" value="<%= locals.volver || '' %>">



      <!-- Errores que devuelve el servidor (por ejemplo, correo o contraseña incorrectos).
           Acepta una lista, un objeto {campo: mensaje} o un solo texto. -->
      <%
        const e1 = modo === 'login' ? (locals.errores || []) : [];
        const lista = [].concat(Array.isArray(e1) || typeof e1 === 'string' ? e1 : Object.values(e1), modo === 'login' ? (locals.error || []) : []).filter(Boolean);
      %>
      <%# Mensaje verde después de registrarse (?registrado=1) y aviso cuando viene de una página privada (HU-004). %>
      <% if (locals.exito) { %><p class="auth-exito" role="status"><%= exito %></p><% } %>
      <% if (locals.passwordRestablecida) { %><p class="auth-exito" role="status">Tu contraseña fue actualizada. Ya puedes iniciar sesión.</p><% } %>
      <% if (locals.aviso && !lista.length) { %><p class="auth-info" role="status"><%= aviso %></p><% } %>
      <% if (lista.length) { %>
        <ul class="auth-errores" role="alert">
          <% lista.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      <% } %>

      <div class="auth-campo">
        <label for="correo">Correo electrónico</label>
        <input type="email" id="correo" name="correo" value="<%= locals.correo || '' %>" maxlength="120" autocomplete="email" required>
      </div>

      <div class="auth-campo">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn-primary auth-boton">Ingresar</button>
      <p class="auth-pie"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
      
    </form>
<% } %>
        </div>
        <div <%= modo !== 'registro' ? 'hidden' : '' %> data-panel="registro">
<% { %>
    <%
      const e1 = modo === 'registro' ? (locals.errores || []) : [];
      const lista = [].concat(Array.isArray(e1) || typeof e1 === 'string' ? e1 : Object.values(e1), modo === 'registro' ? (locals.error || []) : []).filter(Boolean);
      const d = locals.datos || {};
      // HU-002: errores por campo ({ nombre: 'mensaje', ... }) para resaltar cada campo con problema.
      const err = (e1 && typeof e1 === 'object' && !Array.isArray(e1)) ? e1 : {};
      const marca = (campo) => err[campo] ? 'class="campo-error" aria-invalid="true"' : '';
      // Largo permitido de la contraseña: debe coincidir con la regla del controlador.
      const MIN = locals.PASS_MIN || 8, MAX = locals.PASS_MAX || 20;
    %>
    <form class="account-form" id="panel-registro" aria-labelledby="tab-registro" method="post" action="/registro" novalidate>



      <!-- Errores que devuelve el servidor. Acepta una lista, un objeto {campo: mensaje} o un solo texto. -->
      <% if (lista.length) { %>
        <ul class="auth-errores" role="alert">
          <% lista.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      <% } %>

      <div class="auth-fila">
        <div class="auth-campo">
          <label for="registro-nombre">Nombre</label>
          <input <%- marca('nombre') %> type="text" id="registro-nombre" name="nombre" value="<%= d.nombre || '' %>" minlength="2" maxlength="100" autocomplete="given-name" required>
          <% if (err.nombre) { %><p class="auth-aviso"><%= err.nombre %></p><% } %>
        </div>
        <div class="auth-campo">
          <label for="registro-apellido">Apellido</label>
          <input <%- marca('apellido') %> type="text" id="registro-apellido" name="apellido" value="<%= d.apellido || '' %>" minlength="2" maxlength="100" autocomplete="family-name" required>
          <% if (err.apellido) { %><p class="auth-aviso"><%= err.apellido %></p><% } %>
        </div>
      </div>

      <div class="auth-campo">
        <label for="registro-correo">Correo electrónico</label>
        <input <%- marca('correo') %> type="email" id="registro-correo" name="correo" value="<%= d.correo || '' %>" maxlength="120" autocomplete="email" required>
        <% if (err.correo) { %><p class="auth-aviso"><%= err.correo %></p><% } %>
      </div>

      <div class="auth-campo">
        <label for="registro-telefono">Teléfono</label>
        <input <%- marca('telefono') %> type="tel" id="registro-telefono" name="telefono" value="<%= d.telefono || '' %>" maxlength="20" placeholder="+56912345678" autocomplete="tel" required>
        <% if (err.telefono) { %><p class="auth-aviso"><%= err.telefono %></p><% } %>
      </div>

      <div class="auth-campo">
        <label for="registro-password">Contraseña</label>
        <input <%- marca('password') %> type="password" id="registro-password" name="password" maxlength="<%= MAX %>" autocomplete="new-password" aria-describedby="reglas" required>
        <% if (err.password) { %><p class="auth-aviso"><%= err.password %></p><% } %>
        <!-- Requisitos de la contraseña. El servidor es el que valida (controllers/usuariosController.js). -->
        <ul class="auth-reglas" id="reglas">
          <li data-regla="largo" data-min="<%= MIN %>" data-max="<%= MAX %>">Entre <%= MIN %> y <%= MAX %> caracteres</li>
          <li data-regla="mayuscula">Una letra mayúscula</li>
          <li data-regla="minuscula">Una letra minúscula</li>
          <li data-regla="numero">Un número</li>
          <li data-regla="especial">Un carácter especial (! @ # $ % & *)</li>
          <li data-regla="sinEspacios">Sin espacios</li>
        </ul>
      </div>

      <div class="auth-campo">
        <label for="registro-confirmar">Repite la contraseña</label>
        <input <%- marca('confirmar') %> type="password" id="registro-confirmar" name="confirmar" maxlength="<%= MAX %>" autocomplete="new-password" required>
        <% if (err.confirmar) { %><p class="auth-aviso"><%= err.confirmar %></p><% } %>
      </div>

      <button type="submit" class="btn btn-primary auth-boton">Crear cuenta</button>
      
    </form>
<% } %>
        </div>
        <p class="account-note">Compra fácil y revisa tus pedidos en un solo lugar.</p>
      </div>
    </section>
  </main>
  <footer class="account-footer"><strong>AQUAROMA</strong> · Frescura para tu hogar</footer>
</body>
</html>
