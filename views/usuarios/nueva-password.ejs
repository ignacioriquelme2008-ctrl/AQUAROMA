<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Crear contraseña nueva | AQUAROMA', estilos: ['usuarios'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="auth">
    <form class="auth-card" method="post" action="/recuperar/<%= encodeURIComponent(token) %>" novalidate>
      <h1>Crear contraseña nueva</h1>
      <p class="auth-sub">Elige una contraseña segura para volver a entrar a tu cuenta.</p>
      <% if (errorEnlace) { %>
        <p class="auth-errores" role="alert"><%= errorEnlace %></p>
        <p class="auth-pie"><a href="/recuperar">Solicitar otro enlace</a></p>
      <% } else { %>
        <% if (errores.length) { %><ul class="auth-errores" role="alert"><% errores.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
        <div class="auth-campo">
          <label for="password">Contraseña nueva</label>
          <input id="password" name="password" type="password" minlength="8" maxlength="20" autocomplete="new-password" required>
        </div>
        <div class="auth-campo">
          <label for="confirmar">Repite la contraseña</label>
          <input id="confirmar" name="confirmar" type="password" minlength="8" maxlength="20" autocomplete="new-password" required>
        </div>
        <p class="auth-sub">8–20 caracteres, con mayúscula, minúscula, número y carácter especial; sin espacios.</p>
        <button type="submit" class="btn btn-primary auth-boton">Actualizar contraseña</button>
      <% } %>
    </form>
  </main>
</body>
</html>
