<header class="navbar">
  <%# HU-022: el contador lo calcula el servidor (middlewares/carrito.js) antes de dibujar la página. %>
  <% const unidades = locals.carritoCantidad || 0; %>
  <div class="nav-inner">

    <a href="/" class="logo">
      <img src="/img/marca/gota.svg" alt="" class="logo-img" width="24" height="24">
      <div class="logo-text">
        <strong>AQUAROMA</strong>
        <span>Agua funcional</span>
      </div>
    </a>
    <ul class="nav-links">
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Productos</a></li>
      <li><a href="/nosotros">Nosotros</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>

        <!-- La sesión decide si se muestra el nombre y el cierre, o los enlaces para entrar y registrarse. -->
        <div class="nav-acciones">
      <button type="button" class="nav-tema" aria-label="Modo oscuro" aria-pressed="false" title="Modo oscuro" hidden>
        <svg class="nav-tema-luna" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 13a9 9 0 0 1-10-10 9 9 0 1 0 10 10Z"/>
        </svg>
        <svg class="nav-tema-sol" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/>
        </svg>
      </button>
      <% if (locals.usuario) { %>
        <%
          const primerNombre = String(locals.usuario.nombre || '').trim().split(/\s+/)[0] || 'Mi cuenta';
          const inicial = Array.from(primerNombre)[0].toLocaleUpperCase('es-CL');
        %>
        <% if (!locals.usuario.idCliente) { %>
          <span class="nav-identidad"><span class="nav-avatar" aria-hidden="true"><%= inicial %></span><span class="nav-nombre"><%= primerNombre %></span></span>
        <% } %>
        <%# HU-006: el enlace al panel solo aparece si la sesión es de un Administrador. %>
        <% if (locals.usuario.esAdmin) { %><a href="/admin" class="nav-enlace nav-panel">Panel</a><% } %>
        <%# HU-007: el perfil solo existe para los clientes (el administrador no tiene ficha de cliente). %>
        <% if (locals.usuario.idCliente) { %>
          <details class="nav-perfil">
            <summary class="nav-enlace" aria-label="Mi perfil: <%= primerNombre %>"><span class="nav-avatar" aria-hidden="true"><%= inicial %></span><span class="nav-nombre"><%= primerNombre %></span><span class="nav-perfil-flecha" aria-hidden="true"></span></summary>
            <nav class="nav-perfil-opciones" aria-label="Opciones de mi perfil">
              <% if ((locals.usuario.permisos || []).includes('ver_mis_pedidos')) { %>
                <a href="/perfil?seccion=pedidos">Mis pedidos</a>
              <% } %>
              <a href="/perfil">Configuración</a>
            </nav>
          </details>
        <% } %>
        <form method="post" action="/logout"><button type="submit" class="nav-enlace">Cerrar sesión</button></form>
      <% } else { %>
        <a href="/login" class="nav-enlace nav-cuenta"><svg class="nav-cuenta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Mi cuenta</span></a>
      <% } %>
      <a href="/carrito" class="nav-cart" aria-label="Carrito de compras: <%= unidades %> productos">
        <svg class="nav-cart-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M2 3h2l2.2 11.2a2 2 0 0 0 2 1.6h9.9a2 2 0 0 0 2-1.6L22 7H5" />
          <circle cx="9" cy="20" r="1.4" />
          <circle cx="18" cy="20" r="1.4" />
        </svg>
        <span class="nav-contador" aria-hidden="true" <%= unidades > 0 ? '' : 'hidden' %>><%= unidades %></span>
      </a>
    </div>

  </div>

  <%# Aviso de la última acción del carrito ("se agregó", "solo quedan X unidades"). Se muestra una vez. %>
  <% if (locals.avisoCarrito) { %>
    <p class="aviso-carrito" role="status"><%= locals.avisoCarrito %></p>
  <% } %>
</header>
