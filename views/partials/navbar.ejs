<header class="navbar">
  <div class="nav-inner">

    <a href="/" class="logo">
      <img src="/img/marca/logo.jpg" alt="Logo Aquaroma" class="logo-img">
      <div class="logo-text">
        <strong>AQUAROMA</strong>
        <span>Agua funcional</span>
      </div>
    </a>
    <ul class="nav-links">
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/nosotros">Nosotros</a></li>
    </ul>

        <!-- La sesión decide si se muestra el nombre y el cierre, o los enlaces para entrar y registrarse. -->
        <div class="nav-acciones">
      <% if (locals.usuario) { %>
        <span class="nav-usuario">Hola, <%= locals.usuario.nombre %></span>
        <%# HU-006: el enlace al panel solo aparece si la sesión es de un Administrador. %>
        <% if (locals.usuario.esAdmin) { %><a href="/admin" class="nav-enlace nav-panel">Panel</a><% } %>
        <%# data-cerrar-sesion: public/js/carrito.js guarda el último cambio del carrito antes de salir (HU-026). %>
        <form method="post" action="/logout" data-cerrar-sesion><button type="submit" class="nav-enlace">Cerrar sesión</button></form>
      <% } else { %>
        <a href="/login" class="nav-enlace">Iniciar sesión</a>
        <a href="/registro" class="nav-enlace">Registrarse</a>
      <% } %>
      <%# HU-022: el contador de artículos lo actualiza public/js/carrito.js cada vez que cambia el carrito. %>
      <a href="/carrito" class="btn btn-primary">🛒 Carrito <span class="nav-contador" data-contador-carrito hidden>0</span></a>
    </div>

  </div>

  <%# Carrito compartido por todas las páginas (HU-026). data-cliente le dice al script qué cliente
      tiene la sesión iniciada; vacío = visitante (o administrador, que no tiene carrito guardado). %>
  <script src="/js/carrito.js" data-cliente="<%= (locals.usuario && locals.usuario.idCliente) || '' %>"></script>
</header>
