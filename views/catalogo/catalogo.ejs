<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Catálogo | AQUAROMA', estilos: ['catalogo'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="wrap">
    <h1>Nuestro Catálogo</h1>
    <div class="layout">
      <aside>
        <p class="intro">Descubre nuestras aguas funcionales con ingredientes naturales.</p>
        <%# HU-014 y HU-015: los filtros se envían al servidor con GET y el controlador decide qué productos mostrar. %>
        <form class="filters" method="get" action="/catalogo">
          <fieldset>
            <legend>Aroma</legend>
            <label><input type="checkbox" name="aroma" value="todos" <%= filtros.aromas.length === 0 ? 'checked' : '' %>> Todos</label>
            <%# Un filtro por cada aroma que tenga productos activos: un sabor nuevo en la base aparece solo. %>
            <% aromas.forEach((a) => { %>
              <label><input type="checkbox" name="aroma" value="<%= a.slug %>" <%= filtros.aromas.includes(a.slug) ? 'checked' : '' %>> <%= a.nombre %></label>
            <% }) %>
          </fieldset>
          <fieldset>
            <legend>Tipo</legend>
            <label><input type="radio" name="tipo" value="todos" <%= filtros.tipos.length === 0 ? 'checked' : '' %>> Todos</label>
            <%# HU-015: un filtro por cada tipo de agua activo de la base (tabla tipo_agua). %>
            <% tipos.forEach((t) => { %>
              <label><input type="radio" name="tipo" value="<%= t.slug %>" <%= filtros.tipos.includes(t.slug) ? 'checked' : '' %>> <%= t.nombre %></label>
            <% }) %>
          </fieldset>
          <button type="submit" class="aplicar">Filtrar</button>
          <a class="clear" href="/catalogo">Limpiar filtros ↻</a>
        </form>
      </aside>

      <section>
        <p class="count">Mostrando <%= productos.length %> productos</p>
        <div class="grid">
          <% const colores = { limon: 't-yellow', menta: 't-green', frutilla: 't-red', pepino: 't-green', durazno: 't-orange', arandano: 't-purple',
                               mango: 't-orange', 'frutos-rojos': 't-red', 'hibisco-y-rosa': 't-purple', 'limon-y-menta': 't-yellow', 'pepino-y-limon': 't-green' }; %>
          <!-- Cada tarjeta muestra los datos del modelo, incluida la imagen y la disponibilidad del producto. -->
          <% productos.forEach(p => { %>
            <article class="item">
              <%# HU-016: la imagen y el nombre llevan a la ficha de detalle del producto. %>
              <a href="/catalogo/<%= p.id %>" class="item-enlace">
                <div class="img">
                  <img src="/img/productos/<%= p.imagen %>" alt="<%= p.nombre %>">
                  <%# HU-017: cada tarjeta indica si el producto está "Disponible" o "Agotado". %>
                  <% if (p.stock === 0) { %><span class="badge out">Agotado</span><% } else { %><span class="badge disponible">Disponible</span><% } %>
                </div>
                <h3><%= p.nombre %></h3>
              </a>
              <p class="price"><%= clp(p.precio) %></p>
              <span class="tag <%= colores[p.aromaSlug] %>"><%= p.etiqueta %></span>
              <% if (p.stock > 0) { %>
                <%# HU-022: el botón envía el id al controlador; el nombre y el precio los pone el servidor. %>
                <form method="post" action="/carrito/agregar" class="buy-form">
                  <input type="hidden" name="id" value="<%= p.id %>">
                  <input type="hidden" name="volver" value="<%= volver %>">
                  <button type="submit" class="buy">Agregar al carrito</button>
                </form>
              <% } else { %>
                <button class="buy" disabled>Agotado</button>
              <% } %>
            </article>
          <% }) %>
        </div>
        <% if (productos.length === 0) { %>
          <p class="empty">No se encontraron productos con estos filtros. Prueba quitar alguno.</p>
        <% } %>
      </section>
    </div>
  </div>
</body>
</html>
