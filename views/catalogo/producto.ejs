<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: producto.nombre + ' | AQUAROMA', estilos: ['producto'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <!-- Ficha de detalle de un producto (HU-016). Se llega desde la tarjeta del catálogo o desde el inicio. -->
  <main class="ficha-wrap">
    <a href="/catalogo" class="ficha-volver">← Volver al catálogo</a>

    <% const agotado = producto.stock <= 0; %>
    <article class="ficha">
      <div class="ficha-img">
        <img src="<%= imagenProducto(producto.imagen) %>" alt="<%= producto.nombre %>">
        <% if (agotado) { %><span class="badge out">Agotado</span><% } %>
      </div>

      <div class="ficha-info">
        <p class="eyebrow"><%= producto.etiqueta %></p>
        <h1><%= producto.nombre %></h1>
        <p class="ficha-precio" id="precio-personalizado"
           data-precio-base="<%= producto.precio %>"><%= clp(producto.precio) %></p>
        <%# Si todavía no tiene descripción completa, se muestra la etiqueta corta. %>
        <p class="ficha-descripcion"><%= producto.descripcion_larga || producto.etiqueta %></p>

        <dl class="ficha-datos">
          <div><dt>Aroma</dt><dd><%= producto.aroma %></dd></div>
          <div><dt>Tipo de agua</dt><dd><%= producto.tipo %></dd></div>
          <div><dt>Tamaño</dt><dd><%= producto.volumen_ml %> ml<%= producto.tipo_envase ? ' · ' + producto.tipo_envase : '' %></dd></div>
          <div>
            <dt>Disponibilidad</dt>
            <dd>
              <% if (agotado) { %>
                <span class="estado agotado">Agotado</span>
              <% } else { %>
                <span class="estado disponible"><%= producto.stock %> <%= producto.stock === 1 ? 'unidad disponible' : 'unidades disponibles' %></span>
              <% } %>
            </dd>
          </div>
        </dl>

        <% if (producto.personalizable && aromas.length > 0) { %>
          <%# HU-018: los aromas se ofrecen solo si el producto permite personalización; cada opción incluye sus notas. %>
          <fieldset class="aromas-config">
            <legend>Elige tu aroma</legend>
            <% aromas.forEach((aroma, indice) => { %>
              <label class="aroma-opcion">
                <input type="radio" name="idComponente" form="agregar-carrito" value="<%= aroma.id %>"
                       data-recargo-dosis="<%= aroma.recargoPorDosis %>" <%= indice === 0 ? 'checked' : '' %> required>
                <span><strong><%= aroma.nombre %></strong><small><%= aroma.descripcion || 'Aroma natural y equilibrado.' %></small></span>
              </label>
            <% }) %>
            <%# HU-019: la lista limita la selección visual a una cantidad válida entre 1 y 5 dosis. %>
            <label class="intensidad-campo" for="intensidad-aroma">Intensidad del aroma</label>
            <select id="intensidad-aroma" name="intensidad" form="agregar-carrito" required>
              <% Array.from({ length: ventas.MAX_DOSIS_AROMA }, (_, indice) => indice + 1).forEach((dosis) => { %>
                <option value="<%= dosis %>" <%= dosis === 1 ? 'selected' : '' %>><%= dosis %> <%= dosis === 1 ? 'dosis' : 'dosis' %></option>
              <% }) %>
            </select>
            <small class="precio-personalizacion-ayuda" id="ayuda-recargo-dosis">La primera dosis está incluida.</small>
          </fieldset>
        <% } %>

        <% if (agotado) { %>
          <button type="button" class="buy" disabled>Agotado</button>
        <% } else { %>
          <%# HU-018 y HU-022: el servidor valida el aroma; el nombre y el precio siempre salen de la base. %>
          <form id="agregar-carrito" method="post" action="/carrito/agregar" class="buy-form">
            <input type="hidden" name="id" value="<%= producto.id %>">
            <input type="hidden" name="volver" value="<%= volver %>">
            <button type="submit" class="buy">Agregar al carrito</button>
          </form>
        <% } %>
      </div>
    </article>
  </main>
<script src="/js/precio-personalizacion.js" defer></script>
</body>
</html>
