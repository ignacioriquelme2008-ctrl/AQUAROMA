<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Mis pedidos | AQUAROMA', estilos: ['pedidos'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <!-- Lista de pedidos del cliente. Cada uno lleva a su seguimiento (HU-032). Datos: pedidosController.listar. -->
  <main class="pedidos">
    <p class="eyebrow">Mi cuenta</p>
    <h1>Mis pedidos</h1>
    <p class="pedidos-sub">Los montos muestran el total de productos. El costo de entrega se coordina con la tienda.</p>

    <% if (pedidos.length === 0) { %>
      <div class="pedidos-vacio">
        <p>Todavía no tienes pedidos.</p>
        <a href="/catalogo" class="btn btn-primary">Ir al catálogo</a>
      </div>
    <% } else { %>
      <ul class="pedidos-lista">
        <% pedidos.forEach(p => { %>
          <li>
            <a href="/pedidos/<%= p.id %>" class="pedidos-item">
              <span class="pedidos-numero">Pedido #<%= p.id %></span>
              <span class="pedidos-fecha"><%= fechaHora(p.fecha) %></span>
              <span><%= p.unidades %> <%= p.unidades === 1 ? 'unidad' : 'unidades' %></span>
              <strong><%= clp(p.total + p.costo_envio) %></strong>
              <span class="pedidos-estado <%= p.estado %>"><%= nombres[p.estado] %></span>
              <span class="pedidos-ver">Ver seguimiento →</span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
