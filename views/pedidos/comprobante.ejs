<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Comprobante del pedido #' + pedido.id + ' | AQUAROMA', estilos: ['pedidos'] }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <%
    const cancelado = pedido.estado === 'cancelado';
    const pendiente = pedido.estado === 'confirmado' && (!pedido.pago || pedido.pago.estado !== 'aprobado');
    const puedePagar = pendiente && pedido.pago && pedido.pago.metodo === 'PayPal Sandbox';
  %>
  <main class="pedidos comprobante">
    <a href="/perfil?seccion=pedidos" class="pedidos-volver">← Mis pedidos</a>
    <header class="comprobante-cabecera">
      <span class="comprobante-icono <%= cancelado ? 'cancelado' : pendiente ? 'pendiente' : '' %>" aria-hidden="true"><%= cancelado ? '×' : pendiente ? '…' : '✓' %></span>
      <h1><%= cancelado ? 'Pedido cancelado' : pendiente ? 'Tu pedido está registrado' : '¡Gracias por tu compra!' %></h1>
      <div class="comprobante-meta">
        <strong>Pedido #<%= pedido.id %></strong>
        <span><%= fechaHora(pedido.fecha) %></span>
        <span class="pedidos-estado <%= pedido.estado %>"><%= nombres[pedido.estado] %></span>
      </div>
    </header>

    <section class="comprobante-card" aria-labelledby="comprobante-productos">
      <h2 id="comprobante-productos">Tu compra</h2>
      <ul class="comprobante-productos">
        <% pedido.items.forEach(item => { %>
          <li>
            <% if (item.imagen) { %><img src="<%= imagenProducto(item.imagen) %>" alt="" width="48" height="64"><% } %>
            <div class="comprobante-producto">
              <strong><%= item.nombre %></strong>
              <span><%= item.cantidad %> <%= Number(item.cantidad) === 1 ? 'unidad' : 'unidades' %> · <%= clp(item.precio_unitario) %> c/u</span>
            </div>
            <strong class="comprobante-precio"><%= clp(item.subtotal) %></strong>
          </li>
        <% }) %>
      </ul>
      <div class="comprobante-total">
        <div>
          <span><%= pedido.costo_envio > 0 ? 'Total del pedido' : 'Total de productos' %></span>
          <small>IVA incluido</small>
        </div>
        <strong><%= clp(pedido.total + pedido.costo_envio) %></strong>
      </div>

      <section class="comprobante-entrega" aria-labelledby="comprobante-entrega-titulo">
        <h2 id="comprobante-entrega-titulo">Entrega</h2>
        <% if (pedido.envio) { const e = pedido.envio; %>
          <p><%= e.calle %> <%= e.numero || '' %><%= e.departamento ? ', ' + e.departamento : '' %></p>
          <p class="comprobante-secundario"><%= e.comuna %>, <%= e.region %></p>
        <% } else { %>
          <p>Se coordina con la tienda.</p>
        <% } %>
        <% if (!cancelado) { %>
          <p class="comprobante-envio"><%= pedido.costo_envio > 0 ? 'Envío: ' + clp(pedido.costo_envio) + ', incluido en el total.' : 'El costo de envío se coordina con la tienda y no está incluido.' %></p>
        <% } %>
      </section>

      <details class="comprobante-detalles">
        <summary>Ver detalles de la compra</summary>
        <dl class="pedidos-datos">
          <div><dt>Cliente</dt><dd><%= pedido.nombre %> <%= pedido.apellido || '' %></dd></div>
          <div><dt>Correo</dt><dd><%= pedido.correo %></dd></div>
          <div><dt>Medio de pago</dt><dd><%= pedido.pago ? (pedido.pago.metodo === 'PayPal Sandbox' ? 'PayPal' : pedido.pago.metodo) : 'Por definir' %></dd></div>
          <% if (pedido.sucursal) { %><div><dt>Despacha</dt><dd><%= pedido.sucursal %></dd></div><% } %>
          <% if (pedido.envio && pedido.envio.referencia) { %><div><dt>Referencia de entrega</dt><dd><%= pedido.envio.referencia %></dd></div><% } %>
          <div><dt>Neto de productos</dt><dd><%= clp(ventas.neto(pedido.total)) %></dd></div>
          <div><dt>IVA (19%)</dt><dd><%= clp(ventas.iva(pedido.total)) %></dd></div>
        </dl>
      </details>
    </section>

    <div class="comprobante-acciones">
      <% if (puedePagar) { %>
        <a href="/carrito?pagar=<%= pedido.id %>#pago-paypal" class="btn btn-primary">Pagar con PayPal</a>
        <a href="/pedidos/<%= pedido.id %>" class="btn btn-secundario">Ver pedido</a>
      <% } else { %>
        <a href="/pedidos/<%= pedido.id %>" class="btn btn-primary">Ver seguimiento</a>
        <a href="/catalogo" class="btn btn-secundario">Seguir comprando</a>
      <% } %>
    </div>
  </main>
</body>
</html>
