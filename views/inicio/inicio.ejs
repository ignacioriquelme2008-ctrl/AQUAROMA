<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { titulo: 'Aquaroma | Agua funcional', estilos: ['inicio'] }) %>
</head>
<body class="home-page">
  <div class="container home-nav">
    <%- include('../partials/navbar') %>
  </div>

  <main>
    <!-- Esta sección presenta el mensaje principal de la marca y empuja al usuario a explorar el catálogo. -->
    <section class="hero" id="inicio">
      <div class="container">
        <div class="hero-text">
          <p class="eyebrow">Frescura de origen natural</p>
          <h1>Dale sabor <span>a tu hidratación</span></h1>
          <p class="lead">Descubre nuestras infusiones de frutas, hierbas y flores para refrescarte a lo largo del día.</p>
          <div class="hero-acciones">
            <a href="/catalogo" class="btn btn-green">Ver catálogo <span aria-hidden="true">→</span></a>
            <a href="/nosotros" class="btn hero-secundario">Conócenos</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de productos con los aromas destacados para mostrar variedad y captar interés. -->
    <section class="aromas" id="productos">
      <div class="container">
        <h2>Sabores destacados</h2>
        <div class="cards">
          <% destacados.forEach(p => { %>
            <a class="card" href="/catalogo/<%= p.id %>">
              <img src="<%= imagenProducto(p.imagen) %>" alt="" loading="lazy">
              <span class="card-nombre"><%= p.aroma %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
