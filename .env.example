# Modelo del archivo .env. Copia este archivo, llámalo ".env" y completa tus datos.
# El .env real NO se comparte ni se sube a GitHub (está en .gitignore): tiene contraseñas.

# Conexión a MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql
DB_NAME=aquaroma

# Clave para firmar la cookie de sesión. Cualquier texto largo y difícil de adivinar.
SESSION_SECRET=cambia_esto_por_un_texto_largo_y_secreto

# Puerto de la web (opcional; si no está, usa 3000)
PORT=3000

# HU-005 / HU-033: correo transaccional SMTP. Sin estos datos, la compra funciona,
# pero no se envían correos. No compartas ni subas las credenciales reales.
APP_URL=http://localhost:3000
# Opcional: URL pública HTTPS de la foto del encabezado de los correos.
MAIL_PEDIDO_IMAGEN_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# PayPal Sandbox integrado al carrito (solo pruebas; nunca usar estas credenciales en producción).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
