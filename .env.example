# Modelo del archivo .env. Copia este archivo, llámalo ".env" y completa tus datos.
# El .env real NO se comparte ni se sube a GitHub (está en .gitignore): tiene contraseñas.

# Conexión a MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql
DB_NAME=aquaroma

# Clave para firmar la cookie de sesión. Cualquier texto largo y difícil de adivinar.
SESSION_SECRET=cambia_esto_por_un_texto_largo_y_secreto

# Puerto de la web (opcional; si no está, usa 3000)
PORT=3000
